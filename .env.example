# Contenedor y acceso al puerto
PUID=1000
PGID=1000
TZ=Europe/Madrid
HOST_PORT=8088
# 127.0.0.1: solo el servidor; una IP de LAN: esa interfaz; 0.0.0.0: todas.
HOST_BIND=127.0.0.1

# Carpetas persistentes del host (deben permitir escritura a PUID:PGID)
DATA_DIR=./data
LOGS_DIR=./logs

# Valores de instalación: los ajustes guardados desde la interfaz tienen prioridad.
# Tras modificar .env, recrear el contenedor con docker compose up -d.

# Interfaz
# auto detecta el navegador; también admite es y en.
EPLSYNC_UI_LANGUAGE=auto

# Seguridad
# true exige HTTPS y marca la cookie como Secure; no configura TLS ni el proxy.
# false admite HTTP y HTTPS. Ver docs/seguridad.md.
EPLSYNC_SECURITY_REQUIRE_HTTPS=false
# Mínimo inicial de caracteres exigidos (configurable entre 8 y 128).
EPLSYNC_SECURITY_PASSWORD_MIN_LENGTH=8

# Catálogo e importaciones
EPLSYNC_CATALOG_ZIPURL=https://epublibre.org/rssweb/csv/epub.zip
EPLSYNC_CATALOG_IMPORT_RETENTION=24h

# Comprobación de portadas
# connect-timeout <= request-timeout <= batch-timeout; concurrency: 1-32.
EPLSYNC_CATALOG_COVERCHECK_CONNECTTIMEOUT=3s
EPLSYNC_CATALOG_COVERCHECK_REQUESTTIMEOUT=3s
EPLSYNC_CATALOG_COVERCHECK_BATCHTIMEOUT=4s
EPLSYNC_CATALOG_COVERCHECK_CONCURRENCY=4

# Conexión con el cliente torrent
# Activar cuando hayas configurado la URL y las credenciales del cliente.
EPLSYNC_TORRENT_ENABLED=false
EPLSYNC_TORRENT_CLIENT=qbittorrent
EPLSYNC_TORRENT_BASEURL=http://qbittorrent:8090
EPLSYNC_TORRENT_CONNECTTIMEOUT=5s
EPLSYNC_TORRENT_REQUESTTIMEOUT=10s

# Autenticación de qBittorrent
# auto, api-key o session. Configurar API key o usuario y contraseña.
# Para valores con $ literal, usar comillas simples.
EPLSYNC_TORRENT_QBITTORRENT_AUTH_MODE=auto
EPLSYNC_TORRENT_QBITTORRENT_AUTH_USERNAME=
EPLSYNC_TORRENT_QBITTORRENT_AUTH_PASSWORD=
EPLSYNC_TORRENT_QBITTORRENT_AUTH_APIKEY=

# Trackers
# URLs separadas por comas; vacío elimina los trackers adicionales.
EPLSYNC_TORRENT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://www.torrent.eu.org:451/announce,udp://exodus.desync.com:6969/announce,udp://p4p.arenabg.ch:1337/announce,udp://tracker.internetwarriors.net:1337/announce

# Trabajos de descargas
# multiple-hashes: all, first o skip.
EPLSYNC_TORRENT_BULK_MULTIPLEHASHES=all
EPLSYNC_TORRENT_BULK_BATCHSIZE=100
EPLSYNC_TORRENT_BULK_CONCURRENCY=1
EPLSYNC_TORRENT_BULK_INTERVAL=500ms

# Opciones de envío al cliente torrent
# save-path vacío utiliza la ruta del cliente; las listas usan comas.
# Los patrones admiten marcadores como {author}, {title} y {language}.
EPLSYNC_TORRENT_DOWNLOAD_START=true
EPLSYNC_TORRENT_DOWNLOAD_SAVEPATH=
EPLSYNC_TORRENT_RENAME_ENABLED=true
EPLSYNC_TORRENT_RENAME_PATTERN='{author} - {title} [{eplId}] (r{revision})'
EPLSYNC_TORRENT_QBITTORRENT_DOWNLOAD_CATEGORY=Libros
EPLSYNC_TORRENT_QBITTORRENT_DOWNLOAD_TAGS='EPLsync,{language}'
EPLSYNC_TORRENT_QBITTORRENT_DOWNLOAD_AUTOMANAGEMENT=true

# Retención del registro de eventos
# Ambos límites se aplican a la vez.
EPLSYNC_EVENTS_RETENTION_MAX_COUNT=10000
EPLSYNC_EVENTS_RETENTION_MAX_AGE_DAYS=365
