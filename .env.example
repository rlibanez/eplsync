# CONFIGURACIÓN GENERAL

### IMAGEN
EPLSYNC_VERSION=1.3.1

### CONTENEDOR
PUID=1000
PGID=1000
HOST_PORT=8088
TZ=Europe/Madrid

### REGISTRO DE LOGS
# Nivel de EPL Sync: TRACE, DEBUG, INFO, WARN, ERROR u OFF.
# Requiere reiniciar la aplicación o recrear el contenedor.
EPLSYNC_LOG_LEVEL=INFO

### ALMACENAMIENTO
# Las carpetas deben permitir escritura a PUID:PGID.
DATA_DIR=./data
LOGS_DIR=./logs

### CIFRADO DE CREDENCIALES
# Clave para cifrar credenciales guardadas.
# OBLIGATORIA al guardar contraseñas/API keys desde Ajustes.
# Una vez generada y guardada no se debe cambiar.
# Generar con: openssl rand -base64 32
EPLSYNC_SECRET_KEY=

### SEGURIDAD
# Clave opcional para crear el primer administrador. Se introduce en el asistente inicial.
# Déjala vacía para desactivar esta protección.
# Sugerencia de generación: openssl rand -hex 16
EPLSYNC_INITIAL_ADMIN_KEY=
# true exige HTTPS y marca la cookie como Secure.
# false admite HTTP y HTTPS.
EPLSYNC_SECURITY_REQUIRE_HTTPS=false
# Mínimo inicial de caracteres exigidos (configurable entre 8 y 128).
EPLSYNC_SECURITY_PASSWORD_MIN_LENGTH=8

### CATÁLOGO E IMPORTACIONES
EPLSYNC_CATALOG_ZIPURL=https://www.dropbox.com/s/a9r4p7oyaftaz1b/csv_full_imgs.zip?dl=1
# Tiempo máximo que se guardará el zip descargado en el servidor.
EPLSYNC_CATALOG_IMPORT_RETENTION=24h
# Tiempo máximo del proceso de importación/previsualización.
EPLSYNC_CATALOG_IMPORT_OPERATION_TIMEOUT=30m

### COMPROBACIÓN DE PORTADAS
# connect-timeout <= request-timeout <= batch-timeout.
EPLSYNC_CATALOG_COVERCHECK_CONNECTTIMEOUT=3s
EPLSYNC_CATALOG_COVERCHECK_REQUESTTIMEOUT=3s
EPLSYNC_CATALOG_COVERCHECK_BATCHTIMEOUT=4s
# Concurrency: 1-32.
EPLSYNC_CATALOG_COVERCHECK_CONCURRENCY=8

### RETENCIÓN DEL REGISTRO DE EVENTOS
EPLSYNC_EVENTS_RETENTION_MAX_COUNT=10000
EPLSYNC_EVENTS_RETENTION_MAX_AGE_DAYS=365

# CONFIGURACIÓN DE QBITTORRENT

### CONEXIÓN CON EL CLIENTE TORRENT
EPLSYNC_TORRENT_ENABLED=false
EPLSYNC_TORRENT_CLIENT=qbittorrent
EPLSYNC_TORRENT_BASEURL=http://qbittorrent:8080
EPLSYNC_TORRENT_CONNECTTIMEOUT=5s
EPLSYNC_TORRENT_REQUESTTIMEOUT=60s
# Respuesta completa del cliente: 1 KiB–1 GiB y 1–1000000 torrents.
EPLSYNC_TORRENT_MAX_RESPONSE_SIZE=256MB
EPLSYNC_TORRENT_MAX_REMOTE_TORRENTS=500000

### AUTENTICACIÓN DE QBITTORRENT
# auto, api-key o session.
EPLSYNC_TORRENT_QBITTORRENT_AUTH_MODE=auto
# Configurar API key o usuario y contraseña.
# Para valores con $ literal, usar comillas simples.
EPLSYNC_TORRENT_QBITTORRENT_AUTH_USERNAME=
EPLSYNC_TORRENT_QBITTORRENT_AUTH_PASSWORD=
EPLSYNC_TORRENT_QBITTORRENT_AUTH_APIKEY=

### TRACKERS
# URLs separadas por comas; vacío elimina los trackers adicionales.
EPLSYNC_TORRENT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://www.torrent.eu.org:451/announce,udp://exodus.desync.com:6969/announce,udp://p4p.arenabg.ch:1337/announce,udp://tracker.internetwarriors.net:1337/announce

### TRABAJOS DE DESCARGAS
# Libros con múltiples hashes: all, first o skip.
EPLSYNC_TORRENT_BULK_MULTIPLEHASHES=all
EPLSYNC_TORRENT_BULK_BATCHSIZE=100
EPLSYNC_TORRENT_BULK_CONCURRENCY=1
EPLSYNC_TORRENT_BULK_INTERVAL=500ms

### RETENCIÓN DE TRABAJOS FINALIZADOS
# Conserva los que tienen limpiezas pendientes.
EPLSYNC_TORRENT_BULK_RETENTION_ENABLED=true
# Días desde la última actualización (1-36500); intervalo positivo entre ciclos.
EPLSYNC_TORRENT_BULK_RETENTION_DAYS=90
# Espera entre comprobaciones de trabajos finalizados que han superado la retención.
EPLSYNC_TORRENT_BULK_RETENTION_INTERVAL=1h

### LIMPIEZA DIFERIDA DE REVISIONES
# Desactivar no impide el borrado manual.
EPLSYNC_TORRENT_CLEANUP_ENABLED=true
# Intervalo inicial; los valores guardados en Ajustes > Tareas programadas tienen prioridad.
EPLSYNC_TORRENT_CLEANUP_INTERVAL=30s
# Solicitudes por ciclo (1-1000); pendientes bloqueados rotan entre ciclos.
EPLSYNC_TORRENT_CLEANUP_BATCH_SIZE=100

### OPCIONES DE ENVÍO AL CLIENTE TORRENT
# save-path vacío utiliza la ruta del cliente.
# Los patrones admiten marcadores como {author}, {title} y {language}.
EPLSYNC_TORRENT_DOWNLOAD_START=true
EPLSYNC_TORRENT_DOWNLOAD_SAVEPATH=
EPLSYNC_TORRENT_RENAME_ENABLED=true
EPLSYNC_TORRENT_RENAME_PATTERN='{author} - {title} [{eplId}] (r{revision})'
EPLSYNC_TORRENT_QBITTORRENT_DOWNLOAD_CATEGORY=Libros
# Las etiquetas se separan con comas.
EPLSYNC_TORRENT_QBITTORRENT_DOWNLOAD_TAGS='EPLsync,{language}'
EPLSYNC_TORRENT_QBITTORRENT_DOWNLOAD_AUTOMANAGEMENT=true

### DESCARGA DE ARCHIVOS EPUB
# Opcional: carpeta del host con las descargas de qBittorrent.
# Para usarla, descomenta su montaje en docker-compose.yml.
TORRENT_DIR=./torrent

# La carpeta base del cliente vacía desactiva el acceso a los archivos.
# Carpeta base vista por qBittorrent.
EPLSYNC_TORRENT_FILES_REMOTE_ROOT=

# CONFIGURACIÓN DE CALIBRE
# Servidor de contenido; vacío deja la integración sin configurar.
EPLSYNC_CALIBRE_URL=
# Opcional: URL accesible desde el navegador; vacía utiliza la anterior.
EPLSYNC_CALIBRE_BROWSER_URL=
EPLSYNC_CALIBRE_USERNAME=
# No se guarda en la base de datos. Para valores con $ literal, usar comillas simples.
EPLSYNC_CALIBRE_PASSWORD=
# Identificador de biblioteca (no su nombre visible); consultar en Ajustes > Calibre.
EPLSYNC_CALIBRE_LIBRARY=
# Intervalo inicial de comprobación de descargas pendientes en los trabajos de Calibre.
# Los valores guardados en Ajustes > Tareas programadas tienen prioridad.
EPLSYNC_CALIBRE_TRANSFERS_DOWNLOAD_CHECK_INTERVAL=30s
