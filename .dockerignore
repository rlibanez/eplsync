# Solo se envían al builder los archivos necesarios para compilar el backend.
**
!Dockerfile
!backend/
!backend/pom.xml
!backend/mvnw
!backend/.mvn/
!backend/.mvn/**
!backend/src/
!backend/src/main/
!backend/src/main/**
# No empaquetar perfiles locales, credenciales ni archivos de desarrollo.
**/application*.properties
**/application*.yml
**/application*.yaml
!backend/src/main/resources/application.yaml
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.db*
**/*.sqlite*
