# Solo se envían al builder los archivos necesarios para compilar la aplicación.
**
!Dockerfile
!backend/
!backend/pom.xml
!backend/mvnw
!backend/.mvn/
!backend/.mvn/**
!backend/src/
!backend/src/main/
!backend/src/main/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
# No empaquetar perfiles locales, credenciales ni archivos de desarrollo.
**/application*.properties
**/application*.yml
**/application*.yaml
!backend/src/main/resources/application.yaml
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.db*
**/*.sqlite*
